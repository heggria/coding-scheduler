#!/usr/bin/env python3
"""cs — lightweight coding scheduler CLI (no daemon)."""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from affinity import CC_CAP, CODEX_CAP  # noqa: E402
from locks import directory_locks, lock_context  # noqa: E402
from core import (  # noqa: E402
    doctor_checks,
    ensure,
    home,
    load_jobs,
    reclaim,
    remove_job,
    tick,
    write_board,
    write_job,
)

TZ = timezone(timedelta(hours=8))


def cmd_submit(args):
    root = ensure()
    ts = datetime.now(TZ).strftime("%Y%m%d-%H%M%S")
    jid = args.id or f"{args.project}-{args.area}-{ts}"
    prompt_src = Path(args.prompt).expanduser().resolve()
    if not prompt_src.exists():
        print(f"prompt not found: {prompt_src}", file=sys.stderr)
        return 2
    prompt_dst = root / "queue" / f"{jid}.prompt.md"
    prompt_dst.write_text(prompt_src.read_text())
    files = [f.strip() for f in (args.files or "").split(",") if f.strip()]
    shared_files = [f.strip() for f in (args.lock_shared or "").split(",") if f.strip()]
    job = {
        "id": jid,
        "project": args.project,
        "area": args.area,
        "tier": args.tier,
        "pin": args.pin,
        "risk": args.risk,
        "files": files,
        "shared_files": shared_files,
        "cwd": str(Path(args.cwd).expanduser().resolve()),
        "prompt_file": str(prompt_dst),
        "created_at": datetime.now(TZ).isoformat(),
        "status": "queued",
        "pool": None,
        "affinity": {},
        "pid": None,
        "conclusion": None,
        "exit": None,
    }
    if args.review_of:
        job["review_of"] = args.review_of
    job["lock_ctx"] = lock_context(job)
    for path in directory_locks(job["lock_ctx"]):
        print(f"WARNING: directory lock {path!r} covers all descendant paths", file=sys.stderr)
    write_job(root, "queue", job)
    print(jid)
    if args.tick:
        result = tick(root)
        print(json.dumps(result, ensure_ascii=False))
    return 0


def cmd_tick(_args):
    result = tick(ensure())
    print(json.dumps(result, ensure_ascii=False))
    return 0


def cmd_status(args):
    root = ensure()
    # Reap finished workers so the board is not full of corpses, then refresh board.md.
    reclaimed = reclaim(root)
    write_board(root)
    running = load_jobs(root, "running")
    queued = load_jobs(root, "queue")
    c = {"codex": 0, "cc": 0}
    for j in running:
        if j.get("pool") in c:
            c[j["pool"]] += 1
    if args.json:
        print(json.dumps({
            "counts": c,
            "caps": {"codex": CODEX_CAP, "cc": CC_CAP},
            "reclaimed": reclaimed,
            "running": running,
            "queued": queued,
        }, ensure_ascii=False, indent=2))
        return 0
    print(f"Codex {c['codex']}/{CODEX_CAP}  CC {c['cc']}/{CC_CAP}")
    print(f"running={len(running)} queued={len(queued)} reclaimed={reclaimed}")
    for j in running + queued:
        print(f"  [{j.get('status')}] {j.get('id')} tier={j.get('tier')} pool={j.get('pool') or '-'} area={j.get('area')}")
    return 0


def cmd_cancel(args):
    root = ensure()
    jid = args.id
    for folder in ("queue", "running"):
        p = root / folder / f"{jid}.json"
        if not p.exists():
            continue
        job = json.loads(p.read_text())
        if folder == "running" and job.get("pid"):
            try:
                os.kill(int(job["pid"]), 15)
            except OSError:
                pass
        job["status"] = "cancelled"
        if getattr(args, "superseded_by", None):
            job["superseded_by"] = args.superseded_by
        job["finished_at"] = datetime.now(TZ).isoformat()
        remove_job(root, folder, jid)
        write_job(root, "done", job)
        write_board(root)
        if job.get("superseded_by"):
            print(f"cancelled {jid} superseded_by={job['superseded_by']}")
        else:
            print(f"cancelled {jid}")
        return 0
    print(f"not found: {jid}", file=sys.stderr)
    return 1


def cmd_board(_args):
    path = write_board(ensure())
    print(path)
    return 0


def cmd_doctor(args):
    root = ensure()
    print(f"HOME={root}")
    print(f"board={(root / 'board.md').exists()}")
    checks = doctor_checks(getattr(args, "cwd", None))
    bad = 0
    for c in checks:
        mark = "ok" if c["ok"] else "FAIL"
        if not c["ok"]:
            bad += 1
        print(f"{mark}\t{c['name']}\t{c['detail']}")
    return 1 if bad else 0


def main():
    ap = argparse.ArgumentParser(
        prog="cs", description="Lightweight coding scheduler CLI (no daemon)",
        epilog="submit locks: --files a,b (worktree write); --lock-shared a,b (cross-worktree repo resource)",
    )
    sp = ap.add_subparsers(dest="cmd", required=True)

    s = sp.add_parser("submit", help="enqueue a job")
    s.add_argument("--project", required=True)
    s.add_argument("--area", required=True, choices=["backend", "protocol", "frontend", "ui-copy", "test", "review", "ops-script"])
    s.add_argument("--tier", required=True, choices=["L", "M", "H"])
    s.add_argument("--cwd", required=True)
    s.add_argument("--prompt", required=True)
    s.add_argument("--pin", choices=["codex", "cc"], default=None)
    s.add_argument("--risk", choices=["low", "high"], default="low")
    s.add_argument("--files", default="", help="comma-separated worktree write path prefixes")
    s.add_argument("--lock-shared", default="", help="comma-separated repo resource path prefixes (across worktrees)")
    s.add_argument("--id", default=None)
    s.add_argument("--review-of", dest="review_of", choices=["codex", "cc"], default=None)
    s.add_argument("--tick", action="store_true", help="run one schedule pass after submit")
    s.set_defaults(func=cmd_submit)

    t = sp.add_parser("tick", help="reclaim finished + start free slots")
    t.set_defaults(func=cmd_tick)

    st = sp.add_parser("status", help="show pool counts and jobs")
    st.add_argument("--json", action="store_true")
    st.set_defaults(func=cmd_status)

    c = sp.add_parser("cancel", help="cancel queued or running job")
    c.add_argument("id")
    c.add_argument("--superseded-by", dest="superseded_by", default=None, help="replacement job id")
    c.set_defaults(func=cmd_cancel)

    b = sp.add_parser("board", help="rewrite board.md")
    b.set_defaults(func=cmd_board)

    d = sp.add_parser("doctor", help="check paths and CLIs / env preflight")
    d.add_argument("--cwd", default=None, help="optional worktree to probe git write + trusted-dir")
    d.set_defaults(func=cmd_doctor)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
