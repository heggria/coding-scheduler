#!/usr/bin/env python3
"""cs — lightweight coding scheduler CLI (no daemon)."""
from __future__ import annotations

import argparse
import json
import math
import os
import re
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path

LIB = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))

from affinity import CC_CAP, CODEX_CAP
from locks import directory_locks, lock_context
from core import (TZ, check_queue, counts, doctor_checks, ensure, find_job, home,
                  job_summary, kill_worker_group, load_jobs, reason_text, reclaim, remove_job,
                  state_lock, tick, write_board, write_job)


def emit(value):
    print(json.dumps(dict(schema_version="1", **value), ensure_ascii=False))


def error(args, message, code=2):
    if args.json:
        emit({"error": message})
    else:
        print(message, file=sys.stderr)
    return code


def identifier(value):
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", value) or value in (".", ".."):
        raise argparse.ArgumentTypeError("use letters, digits, underscore, dot or hyphen")
    return value


def nonnegative(value):
    number = float(value)
    if not math.isfinite(number) or number < 0:
        raise argparse.ArgumentTypeError("must be a finite nonnegative number")
    return number


def line_count(value):
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError("must be nonnegative")
    return number


def cmd_submit(args):
    files = [f.strip() for f in args.files.split(",") if f.strip()]
    shared_files = [f.strip() for f in args.lock_shared.split(",") if f.strip()]
    if not files and not (args.area == "research" and args.read_only):
        return error(args, "--files is required: list each output/writable file path individually (including review docs), never a directory; empty --files is allowed only for --area research --read-only. "
                     "必须用 --files 逐一列出输出/可写文件的准确路径（包括要写的评审文档），不要填写目录；仅 --area research --read-only 可留空。")
    root = ensure()
    if args.idempotency_key:
        for folder in ("queue", "running", "done"):
            for job in load_jobs(root, folder):
                if job.get("idempotency_key") == args.idempotency_key:
                    return submitted(args, job, existing=True)
    jid = args.id or "%s-%s-%s-%s" % (
        args.project, args.area, datetime.now(TZ).strftime("%Y%m%d-%H%M%S"), uuid.uuid4().hex[:8])
    if find_job(root, jid):
        return error(args, "job id already exists: " + jid)
    cwd = Path(args.cwd).expanduser().resolve()
    if not cwd.is_dir():
        return error(args, "cwd is not a directory: " + str(cwd))
    if args.prompt_text is not None:
        body = args.prompt_text
    elif args.prompt == "-":
        body = sys.stdin.read()
    else:
        body = Path(args.prompt).expanduser().read_text()
    declaration = "\n".join([
        '## 本单声明',
        '- cwd: ' + str(cwd),
        '- 可写文件清单 (files): ' + (json.dumps(files, ensure_ascii=False) if files else '无'),
        '- shared 锁文件 (shared_files): ' + (json.dumps(shared_files, ensure_ascii=False) if shared_files else '无'),
        '- area: ' + args.area,
        '- read-only: ' + ('是' if args.read_only else '否'),
    ])
    body = declaration + "\n\n" + body
    template = root / "projects" / (args.project + ".md")
    if not args.no_template and template.is_file():
        body = template.read_text().rstrip() + "\n\n" + body
    prompt_dst = root / "queue" / (jid + ".prompt.md")
    prompt_dst.write_text(body)
    job = {
        "id": jid, "project": args.project, "area": args.area, "tier": args.tier,
        "pin": args.pin, "risk": args.risk,
        "files": files,
        "shared_files": shared_files,
        "cwd": str(cwd), "prompt_file": str(prompt_dst),
        "created_at": datetime.now(TZ).isoformat(), "status": "queued",
        "pool": None, "affinity": {}, "pid": None, "conclusion": None, "exit": None,
        "idempotency_key": args.idempotency_key, "model": args.model,
        "read_only": args.read_only,
    }
    if args.review_of:
        job["review_of"] = args.review_of
    job["lock_ctx"] = lock_context(job)
    for path in directory_locks(job["lock_ctx"]):
        print("WARNING: directory lock %r covers all descendant paths" % path, file=sys.stderr)
    check_queue(root, job, load_jobs(root, "running"))
    if not args.tick:
        job["queue_reasons"].append({"type": "awaiting_tick"})
    write_job(root, "queue", job)
    if args.tick:
        tick(root)
    write_board(root)
    return submitted(args, find_job(root, jid))


def submitted(args, job, existing=False):
    if args.json:
        result = {"id": job["id"], "existing": existing, "job": job_summary(job)}
        emit(result)
    else:
        print(job["id"])
        if job.get("status") == "queued":
            print(reason_text(job.get("queue_reasons", [])))
    return 0


def cmd_tick(args):
    result = tick(ensure())
    # launchd commonly redirects stdout to tick.log. Keep its default bounded.
    emit(result if args.json else {"reclaimed": result["reclaimed"],
         "started_count": len(result["started"]), "counts": result["counts"],
         "queued_count": len(result["queued"])})
    return 0


def cmd_status(args):
    root = home() if args.no_reclaim else ensure()
    reclaimed = 0
    if not args.no_reclaim:
        reclaimed = reclaim(root)
        write_board(root)
    if args.id:
        job = find_job(root, args.id)
        if job is None:
            return error(args, "not found: " + args.id, 1)
        summary = job_summary(job, args.lines)
        if args.json:
            emit({"job": summary})
        else:
            print("[%s] %s exit=%s elapsed=%ss" % (summary["status"], args.id,
                  summary["exit"], summary["elapsed_seconds"]))
            print(reason_text(summary["queue_reasons"]))
            print("\n".join(summary["conclusion"]))
            print(json.dumps(summary["artifacts"], ensure_ascii=False))
        return 0
    running, queued = load_jobs(root, "running"), load_jobs(root, "queue")
    c = counts(running)
    if args.json:
        emit({"counts": c, "caps": {"codex": CODEX_CAP, "cc": CC_CAP},
              "reclaimed": reclaimed, "running": running, "queued": queued})
    else:
        print("Codex %s/%s  CC %s/%s" % (c["codex"], CODEX_CAP, c["cc"], CC_CAP))
        print("running=%s queued=%s reclaimed=%s" % (len(running), len(queued), reclaimed))
        for job in running + queued:
            print("  [%s] %s tier=%s pool=%s area=%s %s" %
                  (job.get("status"), job["id"], job.get("tier"), job.get("pool") or "-",
                   job.get("area"), reason_text(job.get("queue_reasons", []))))
    return 0


def cmd_wait(args):
    root = ensure()
    deadline = None if args.timeout is None else time.monotonic() + args.timeout
    ids = list(dict.fromkeys(args.ids))
    while True:
        # Release the state lock between checks so tick/cancel/other bots can run.
        with state_lock(root):
            reclaim(root)
            jobs = [find_job(root, jid) for jid in ids]
            missing = [jid for jid, job in zip(ids, jobs) if job is None]
            if missing:
                emit({"error": "not found", "ids": missing})
                return 1
            if args.tick and any(job.get("status") in ("queued", "running") for job in jobs):
                tick(root)
                jobs = [find_job(root, jid) for jid in ids]
            finished = all(job.get("status") not in ("queued", "running") for job in jobs)
            timed_out = not finished and deadline is not None and time.monotonic() >= deadline
            if finished or timed_out:
                write_board(root)
                emit({"timed_out": timed_out, "jobs": [job_summary(job, args.lines) for job in jobs]})
                return 124 if timed_out else 0
        remaining = None if deadline is None else deadline - time.monotonic()
        time.sleep(0.2 if remaining is None else max(0, min(0.2, remaining)))


def cmd_cancel(args):
    root = ensure()
    for folder in ("queue", "running"):
        path = root / folder / (args.id + ".json")
        if not path.exists():
            continue
        job = json.loads(path.read_text())
        if folder == "running":
            # Older workers also launched as session leaders, but only stored pid.
            pgid = job.get("pgid") or job.get("pid")
            job.update(kill_worker_group(pgid) if pgid else
                       {"cancel_killed_pids": [], "cancel_signal": None})
        job.update(status="cancelled", finished_at=datetime.now(TZ).isoformat(), queue_reasons=[])
        if args.superseded_by:
            job["superseded_by"] = args.superseded_by
        write_job(root, "done", job)
        remove_job(root, folder, args.id)
        write_board(root)
        if args.json:
            emit({"job": job_summary(job), "superseded_by": args.superseded_by})
        else:
            print("cancelled " + args.id + (" superseded_by=" + args.superseded_by if args.superseded_by else ""))
        return 0
    return error(args, "not found: " + args.id, 1)


def cmd_board(args):
    path = write_board(ensure())
    if args.json:
        emit({"path": str(path)})
    else:
        print(path)
    return 0


def cmd_doctor(args):
    root = ensure()
    checks = doctor_checks(args.cwd, args.pool)
    failed = any(c["level"] == "FAIL" for c in checks)
    if args.json:
        emit({"home": str(root), "board": (root / "board.md").exists(), "checks": checks})
    else:
        print("HOME=" + str(root))
        for check in checks:
            print("%s\t%s\t%s" % (check["level"], check["name"], check["detail"]))
    return 1 if failed else 0


def cmd_dashboard(args):
    from dashboard import serve
    return serve(args, cmd_status)


class Parser(argparse.ArgumentParser):
    def error(self, message):
        if "--json" in sys.argv:
            emit({"error": message})
            self.exit(2)
        super().error(message)


def main():
    ap = Parser(prog="cs", description="Lightweight coding scheduler CLI (no daemon)")
    ap.add_argument("--json", action="store_true")
    sp = ap.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("submit", help="enqueue a job")
    s.add_argument("--project", required=True, type=identifier)
    s.add_argument("--area", required=True, choices=["backend", "protocol", "frontend", "ui-copy", "test", "review", "ops-script", "research"])
    s.add_argument("--tier", required=True, choices=["L", "M", "H"])
    s.add_argument("--cwd", required=True)
    prompt = s.add_mutually_exclusive_group(required=True)
    prompt.add_argument("--prompt", help="prompt file, or - for stdin")
    prompt.add_argument("--prompt-text", help="inline prompt")
    s.add_argument("--no-template", action="store_true")
    s.add_argument("--model", default=None)
    s.add_argument("--idempotency-key", default=None)
    s.add_argument("--pin", choices=["codex", "cc"], default=None)
    s.add_argument("--risk", choices=["low", "high"], default="low")
    s.add_argument("--files", default="", help="comma-separated exact output/writable file paths, including review docs; empty only with --area research --read-only (directory paths warn)")
    s.add_argument("--lock-shared", default="", help="comma-separated exact resource paths")
    s.add_argument("--id", type=identifier, default=None)
    s.add_argument("--review-of", choices=["codex", "cc"], default=None)
    s.add_argument("--read-only", action="store_true", help="conclusion does not require code delivery; empty --files only with --area research")
    s.add_argument("--tick", action="store_true")
    s.set_defaults(func=cmd_submit)

    t = sp.add_parser("tick", help="reclaim finished + start free slots")
    t.set_defaults(func=cmd_tick)
    st = sp.add_parser("status", help="show pools, or one job including completed jobs")
    st.add_argument("id", nargs="?", type=identifier)
    st.add_argument("--lines", type=line_count, default=20)
    st.add_argument("--no-reclaim", "--read-only", action="store_true",
                    help="only read state; do not reclaim, initialize or rewrite board")
    st.set_defaults(func=cmd_status)
    w = sp.add_parser("wait", help="wait for all jobs; optionally tick the scheduler each round")
    w.add_argument("ids", nargs="+", type=identifier)
    w.add_argument("--timeout", type=nonnegative, default=None)
    w.add_argument("--lines", type=line_count, default=20)
    w.add_argument("--tick", action="store_true", help="advance the scheduler while waiting")
    w.set_defaults(func=cmd_wait)
    c = sp.add_parser("cancel", help="cancel queued or running job")
    c.add_argument("id", type=identifier)
    c.add_argument("--superseded-by", default=None)
    c.set_defaults(func=cmd_cancel)
    b = sp.add_parser("board", help="rewrite board.md")
    b.set_defaults(func=cmd_board)
    d = sp.add_parser("doctor", help="check paths and CLIs / env preflight")
    d.add_argument("--cwd", default=None)
    d.add_argument("--pool", choices=["codex", "cc"], default=None, help="required worker CLI; other CLI checks only warn")
    d.set_defaults(func=cmd_doctor)
    dashboard = sp.add_parser("dashboard", help="serve the read-only live dashboard")
    dashboard.add_argument("--host", default="127.0.0.1")
    dashboard.add_argument("--port", type=int, default=8787)
    dashboard.set_defaults(func=cmd_dashboard)
    for parser in (s, t, st, w, c, b, d):
        parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    args = ap.parse_args()
    try:
        if args.cmd in ("wait", "dashboard") or (args.cmd == "status" and args.no_reclaim):
            return args.func(args)
        with state_lock(ensure()):
            return args.func(args)
    except (OSError, ValueError) as exc:
        return error(args, str(exc))
    except KeyboardInterrupt:
        return error(args, "interrupted", 130)


if __name__ == "__main__":
    raise SystemExit(main())
